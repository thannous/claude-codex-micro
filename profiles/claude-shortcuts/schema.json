{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codex-micro-claude/shortcut-profile.schema.json",
  "title": "Codex Micro Claude shortcut profile",
  "type": "object",
  "required": [
    "id",
    "status",
    "target",
    "preservation",
    "activation",
    "layerBinding",
    "controls",
    "outsideAppLinkedLayer",
    "excludedByDefault"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "proposal-not-applied"
    },
    "target": {
      "type": "object",
      "required": [
        "platform",
        "appBundleId",
        "observedAppVersion",
        "deviceFamily"
      ],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "const": "macOS"
        },
        "appBundleId": {
          "const": "com.anthropic.claudefordesktop"
        },
        "observedAppVersion": {
          "type": "string"
        },
        "deviceFamily": {
          "type": "string"
        }
      }
    },
    "preservation": {
      "type": "object",
      "required": [
        "mode",
        "unlistedControls",
        "touchLayerControl",
        "otherLayers",
        "otherProfiles",
        "otherAppSenseLinks"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "do-not-replace-existing-layers"
        },
        "unlistedControls": {
          "const": "unchanged"
        },
        "touchLayerControl": {
          "const": "reserved"
        },
        "otherLayers": {
          "const": "unchanged"
        },
        "otherProfiles": {
          "const": "unchanged"
        },
        "otherAppSenseLinks": {
          "const": "unchanged"
        }
      }
    },
    "activation": {
      "type": "object",
      "required": [
        "type",
        "provider",
        "application",
        "detectionMethod",
        "focusRequirementSeconds",
        "bindingStatus",
        "focusLossBehavior"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "appsense-foreground-application"
        },
        "provider": {
          "const": "Work Louder Input"
        },
        "application": {
          "type": "object",
          "required": ["name", "bundleId"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "Claude"
            },
            "bundleId": {
              "const": "com.anthropic.claudefordesktop"
            }
          }
        },
        "detectionMethod": {
          "const": "auto-detect"
        },
        "focusRequirementSeconds": {
          "const": 5
        },
        "bindingStatus": {
          "const": "proposal-not-applied"
        },
        "focusLossBehavior": {
          "const": "manual-validation-required"
        }
      }
    },
    "layerBinding": {
      "type": "object",
      "required": [
        "targetKind",
        "layerId",
        "selectionStatus",
        "overwriteMapping",
        "nativePresetImport"
      ],
      "additionalProperties": false,
      "properties": {
        "targetKind": {
          "const": "existing-layer"
        },
        "layerId": {
          "type": "null"
        },
        "selectionStatus": {
          "const": "pending-inventory-and-approval"
        },
        "overwriteMapping": {
          "const": false
        },
        "nativePresetImport": {
          "const": "not-confirmed"
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["control", "label", "action", "evidence", "risk"],
        "additionalProperties": false,
        "properties": {
          "control": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "object"
          },
          "evidence": {
            "enum": [
              "installed-bundle-menu",
              "anthropic-help-center",
              "anthropic-code-docs",
              "manual-validation-required"
            ]
          },
          "risk": {
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "outsideAppLinkedLayer": {
      "type": "array",
      "minItems": 2
    },
    "excludedByDefault": {
      "type": "array",
      "minItems": 2
    }
  }
}
