{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thannous/claude-codex-micro/raw/main/profiles/claude-shortcuts/schema.json",
  "title": "Codex Micro Claude shortcut profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "target",
    "preservation",
    "activation",
    "layerBinding",
    "appearance",
    "controls",
    "unusedControls",
    "outsideAppLinkedLayer",
    "excludedByDefault"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "const": "claude-desktop-macos-codex-micro-v1" },
    "status": { "const": "proposal-not-applied" },
    "target": { "type": "object" },
    "preservation": {
      "type": "object",
      "required": [
        "mode",
        "protectedLayerIndexes",
        "unlistedControls",
        "touchLayerControl",
        "otherLayers",
        "otherProfiles",
        "otherAppSenseLinks"
      ]
    },
    "activation": { "type": "object" },
    "layerBinding": { "type": "object" },
    "appearance": {
      "type": "object",
      "required": ["name", "rgb"],
      "properties": {
        "name": { "const": "Claude" },
        "rgb": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control", "physicalPosition", "label", "action", "evidence", "risk"],
        "properties": {
          "control": { "type": "string" },
          "physicalPosition": { "type": "string" },
          "label": { "type": "string" },
          "action": { "type": "object" },
          "evidence": {
            "enum": ["installed-bundle-menu", "anthropic-help-center", "manual-validation-required"]
          },
          "risk": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "unusedControls": { "type": "array", "minItems": 1 },
    "outsideAppLinkedLayer": { "type": "array", "minItems": 2 },
    "excludedByDefault": { "type": "array", "minItems": 6 }
  }
}
